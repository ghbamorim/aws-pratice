{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRDS",
      "Effect": "Allow",
      "Action": [
        "rds:Describe*",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageRDS",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "rds:AddTagsToResource",
        "rds:RemoveTagsFromResource",
        "rds:CreateDBSubnetGroup",
        "rds:ModifyDBSubnetGroup",
        "rds:DeleteDBSubnetGroup"
      ],
      "Resource": [
        "arn:aws:rds:us-east-2:242627333067:db:aws-pratice-postgres",
        "arn:aws:rds:us-east-2:242627333067:subgrp:aws-pratice-postgres-subnets"
      ]
    }
  ]
}
